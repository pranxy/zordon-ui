{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss",
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "projects": {
    "components": {
      "projectType": "library",
      "root": "projects/components",
      "sourceRoot": "projects/components/src",
      "prefix": "zd",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/components/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/components/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/components/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "components:build:development",
            "include": ["**/*.spec.ts"],
            "runner": "vitest",
            "tsConfig": "projects/components/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/components/src/**/*.ts",
              "projects/components/src/**/*.html"
            ]
          }
        }
      }
    },
    "dev": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        }
      },
      "root": "projects/dev",
      "sourceRoot": "projects/dev/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/dev",
              "browser": ""
            },
            "index": "projects/dev/src/index.html",
            "browser": "projects/dev/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/dev/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": ["projects/dev/src/favicon.ico", "projects/dev/src/assets"],
            "styles": ["projects/dev/src/styles.css"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": true
                },
                "fonts": false
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "dev:build:production"
            },
            "development": {
              "buildTarget": "dev:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "dev:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "projects/dev/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": ["projects/dev/src/favicon.ico", "projects/dev/src/assets"],
            "styles": ["projects/dev/src/styles.scss"],
            "scripts": []
          }
        },
        "deploy": {
          "builder": "angular-cli-ghpages:deploy"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/dev/**/*.ts", "projects/dev/**/*.html"]
          }
        }
      }
    },
    "ssr-example": {
      "projectType": "application",
      "root": "projects/ssr-example",
      "sourceRoot": "projects/ssr-example/src",
      "prefix": "ssr",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/ssr-example",
            "index": "projects/ssr-example/src/index.html",
            "browser": "projects/ssr-example/src/main.ts",
            "server": "projects/ssr-example/src/main.server.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/ssr-example/tsconfig.app.json",
            "styles": ["projects/ssr-example/src/styles.css"],
            "outputMode": "server",
            "ssr": {
              "entry": "projects/ssr-example/src/server.ts"
            },
            "security": {
              "allowedHosts": ["127.0.0.1", "localhost"]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "300kb",
                  "maximumError": "400kb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kb",
                  "maximumError": "8kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ssr-example:build:production"
            },
            "development": {
              "buildTarget": "ssr-example:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ssr-example/src/**/*.ts",
              "projects/ssr-example/src/**/*.html"
            ]
          }
        }
      }
    }
  }
}
