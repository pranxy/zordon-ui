{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "projectFolder": "../projects/components",
  "mainEntryPointFilePath": "<projectFolder>/../../dist/components/types/pranxy-zordon-ui-theme-controller.d.ts",
  "compiler": {
    "tsconfigFilePath": "<projectFolder>/tsconfig.api-extractor-theme-controller.json"
  },
  "apiReport": {
    "enabled": true,
    "reportFileName": "zordon-ui-theme-controller",
    "reportFolder": "<projectFolder>/../../etc/api",
    "reportTempFolder": "<projectFolder>/../../temp/api-extractor",
    "reportVariants": ["complete"],
    "includeForgottenExports": true
  },
  "docModel": { "enabled": false },
  "dtsRollup": { "enabled": false },
  "tsdocMetadata": { "enabled": false },
  "messages": {
    "compilerMessageReporting": { "default": { "logLevel": "warning" } },
    "extractorMessageReporting": {
      "default": { "logLevel": "warning" },
      "ae-forgotten-export": { "logLevel": "error", "addToApiReportFile": true },
      "ae-missing-release-tag": { "logLevel": "none" },
      "ae-undocumented": { "logLevel": "none" }
    },
    "tsdocMessageReporting": { "default": { "logLevel": "warning" } }
  }
}
